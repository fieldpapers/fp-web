<% content_for :title, _("Dashboard - Field Papers") %>

<div class="row">
  <h2 class="twelve columns"><%= _("Welcome, %{username}") % { username: current_user.username } %></h2>
</div>

<% if @atlases.empty? && @snapshots.empty? %>
  <%= render "onboarding" %>
<% else %>
  <h4><%= _("Your atlases") %></h4>
  <ul class="map-cards">
    <%= render "new_card", path: compose_path, image: "atlases-large.gif", label: _("Make an atlas") %>
    <%= render partial: "atlases/atlas", collection: @atlases, locals: { page_counts: @page_counts } %>
  </ul>

  <h4><%= _("Your snapshots") %></h4>
  <ul class="map-cards">
    <%= render "new_card", path: new_snapshot_path, image: "snapshots-large.gif", label: _("Upload a snapshot") %>
    <%= render partial: "snapshots/snapshot", collection: @snapshots %>
  </ul>
<% end %>
