<% content_for :title, _('Make - Field Papers') %>

<%= form_for :atlas, html: { id: "compose-form" } do |f| %>
  <% [:zoom, :west, :south, :east, :north, :rows, :cols].each do |attr| %>
    <%= f.hidden_field attr, value: @atlas[attr] %>
  <% end %>

  <fieldset>
    <legend><%= _("Atlas information") %></legend>
    <%= f.text_field :title, placeholder: _("Atlas Title"), "aria-label": _("Atlas Title") %>

    <div class="checkbox">
      <%= f.check_box :layout %>
      <%= f.label :layout, _("Print notes") %>
      <span class="help" tabindex="0" data-tooltip="<%= _("If you choose to include notes, your map will be printed on the top half a page with notes displayed on the bottom half. Otherwise, maps will be displayed on a full page.") %>">(?)</span>
    </div>
    <div class="notes">
      <%= f.label :text, _("Notes") %>
      <%= f.text_area :text %>
    </div>
    <div class="checkbox">
      <%= f.check_box :private %>
      <%= f.label :private, _("Keep atlas private") %>
      <span class="help" tabindex="0" data-tooltip="<%= _("Private atlases aren't listed on Field Papers, but anyone with the link can open them. When you're logged in, you'll find them on your dashboard.") %>">(?)</span>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= _("Grid layout") %></legend>
    <div class="paper">
      <div>
        <%= f.label :paper_size, _("Paper size") %>
        <%= f.select :paper_size, options_for_select([["Letter", "letter"], ["A3", "a3"], ["A4", "a4"]]) %>
      </div>
      <div>
        <%= f.label :orientation, _("Orientation") %>
        <%= f.select :orientation, options_for_select([["Landscape", "landscape"], ["Portrait", "portrait"]]) %>
      </div>
    </div>
    <%= f.label :provider, _("Basemap") %>
    <%= f.select :provider, options_for_select(Providers.options, [Providers.default]) %>

    <div class="checkbox">
      <input type="checkbox" id="pin-grid">
      <label for="pin-grid"><%= _("Pin grid to map") %></label>
    </div>
  </fieldset>

  <%= f.submit _("Make Atlas") %>
<% end %>

<div id="compose-map">
  <div class="grid-controls">
    <div class="grid-control">
      <%= icon "menu", "rotate-90" %>
      <button type="button" id="cols-minus" aria-label="<%= _("Remove column") %>">-</button>
      <output id="cols-count">2</output>
      <button type="button" id="cols-plus" aria-label="<%= _("Add column") %>">+</button>
    </div>
    <div class="grid-control">
      <%= icon "menu" %>
      <button type="button" id="rows-minus" aria-label="<%= _("Remove row") %>">-</button>
      <output id="rows-count">1</output>
      <button type="button" id="rows-plus" aria-label="<%= _("Add row") %>">+</button>
    </div>
  </div>
</div>

<% content_for :foot do %>
<script>
  $(function(){
    FP.map.compose.select({
      selector: 'compose-map',
      initialView: [[<%= @initial_lat %>, <%= @initial_lon %>], <%= @initial_zoom %>],
      tileProviders: <%= Providers.layers.to_json.html_safe %>,
      defaultProvider: "<%= Providers.default %>",
      maxRows: <%= Atlas::MAX_ROWS %>,
      maxPages: <%= Atlas::MAX_PAGES %>
    });
  });
</script>
<% end %>
