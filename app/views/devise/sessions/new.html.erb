<h2><%= t('.sign_in', default: "Sign in") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <%= f.label :login %>
  <%= f.text_field :login, autofocus: true, required: true, placeholder: "..." %>

  <%= f.label :password %>
  <%= f.password_field :password, autocomplete: "off", required: true %>

  <% if devise_mapping.rememberable? -%>
    <%= f.label :remember_me do %>
      <%= f.check_box :remember_me %>
      <%= t(".remember_me", default: "Remember Me") %>
    <% end %>
  <% end -%>

  <div class="actions">
    <%= f.submit t('.sign_in', :default => "Sign in") %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
