<% content_for :title, _("Atlases - Field Papers") %>

<div class="map-container">
  <div id="map" class="map"></div>
  <p class="inline-linkbar bottom">
    <%= n_("%{count} Atlas", "%{count} Atlases", @counts) % {count: number_with_delimiter(@counts) } %> | <%= link_to _("Snapshots"), snapshots_path %>
  </p>
</div>

<% if @atlases.empty? %>
<p class="empty-state"><%= _("No atlases.") %></p>
<% else %>
<%= paginate @atlases %>

<ul class="map-cards">
  <%= render partial: "atlas", collection: @atlases, locals: { page_counts: @page_counts } %>
</ul>

<%= paginate @atlases %>
<% end %>

<% content_for :foot do %>
  <script>
    $(function(){
      var providerTemplate = "<%= FieldPapers::ATLAS_INDEX_HEADER_TILELAYER.html_safe %>";
      var providerAttribution = '<a href="https://openstreetmap.org/copyright" target="_blank">© OpenStreetMap</a>';
      FP.map.boundingBoxes('map',{
        provider: providerTemplate,
        providerSettings: [{options:{
          attribution: providerAttribution
        }}]
      }).data(<%= raw(@atlases.to_json) %>);
    });
  </script>
<% end %>
